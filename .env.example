# BusyManager — variables compartidas (copiar a .env en raíz y en cada app)

# API
MATRIX_API_URL=http://localhost:8080
MATRIX_API_PORT=8080

# MySQL (docker o local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=busymanager
DB_USERNAME=busymanager
DB_PASSWORD=secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Mail (Mailpit en dev)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=alerts@busymanager.local
MAIL_FROM_NAME=BusyManager

# OAuth (opcional en dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8080
